# .env.local로 복사해서 채운다(VS Code로 저장 — 메모장 BOM 주의). 바꾼 뒤 dev 서버 재시작.
# Vercel: Project → Settings → Environment Variables에 같은 이름으로 붙여넣는다.

# ── Supabase (브라우저에 노출되는 공개 값) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 설계 에이전트 1순위: 코디세이 (Anthropic 호환) ───────────────────────
# base URL은 /v1 포함 여부 상관없음(코드가 /v1까지 맞춘다). /api/health?ping=1 로 확인.
CODYSSEY_ANTHROPIC_BASE_URL=
CODYSSEY_DRAFT_KEY=
CODYSSEY_MODEL=
# 인증 헤더: both(기본: x-api-key + Bearer) | bearer | x-api-key
CODYSSEY_AUTH_STYLE=both

# ── 설계 에이전트 2순위(폴백): Claude 공식 API (Console 키) ────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 순서를 바꾸려면: anthropic,codyssey
DRAFTER_ORDER=codyssey,anthropic

# ── 검수 에이전트(선택) — 둘 중 하나만 있어도 됨 ─────────────────────────
CODYSSEY_OPENAI_BASE_URL=
CODYSSEY_REVIEW_KEY=
REVIEWER_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 한도 ─────────────────────────────────────────────────────────────
AGENT_MAX_STEPS_PER_SESSION=30
AGENT_TIMEOUT_MS=15000

# ── 폰 LAN 접속(개발 서버 전용) ──────────────────────────────────────
# 192.168.*.*, 10.*.*.*, 172.20.10.*(아이폰 핫스팟)은 이미 허용. 그 밖의 IP만 쉼표로.
DEV_LAN_HOSTS=
